<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="database" path="budget_brewer.db"/>
        <exclude domain="database" path="budget_brewer.db-shm"/>
        <exclude domain="database" path="budget_brewer.db-wal"/>

        <exclude domain="sharedpref" path="supabase_auth.xml"/>
        <exclude domain="sharedpref" path="auth.xml"/>
        <exclude domain="sharedpref" path="app_lock.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Mirror cloud backup exclusions for device-to-device transfer -->
        <exclude domain="database" path="budget_brewer.db"/>
        <exclude domain="database" path="budget_brewer.db-shm"/>
        <exclude domain="database" path="budget_brewer.db-wal"/>

        <exclude domain="sharedpref" path="supabase_auth.xml"/>
        <exclude domain="sharedpref" path="auth.xml"/>
        <exclude domain="sharedpref" path="app_lock.xml"/>
    </device-transfer>
</data-extraction-rules>
