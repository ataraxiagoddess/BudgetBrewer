<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="4dp"
    android:paddingHorizontal="12dp"
    android:layout_marginBottom="2dp"
    android:gravity="center_vertical"
    android:background="@null">

    <!-- Time frame column – wraps content, single line -->
    <TextView
        android:id="@+id/tvTimeFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="90dp"
        android:maxLines="2"
        android:ellipsize="end"
        style="@style/TextAppearance.BudgetBrewer.Subtext"
        android:textColor="@color/text_on_container"
        android:layout_marginEnd="12dp"
        android:gravity="start"
        android:background="@null"/>

    <!-- Source column – takes remaining space -->
    <TextView
        android:id="@+id/tvSource"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxWidth="200dp"
        android:maxLines="2"
        android:ellipsize="end"
        style="@style/TextAppearance.BudgetBrewer.Body"
        android:textColor="@color/text_on_container"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:gravity="center"
        android:background="@null"
        tools:ignore="VisualLintSystemUi" />

    <!-- Amount column – wraps content, left aligned -->
    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="120dp"
        android:maxLines="2"
        android:ellipsize="end"
        style="@style/TextAppearance.BudgetBrewer.Body"
        android:textColor="@color/text_on_container"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:background="@null"/>

    <!-- Buttons (unchanged) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddIncome"
        style="@style/Widget.BudgetBrewer.Button.Container"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/add_income_button"
        android:visibility="gone"
        app:icon="@null" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditIncome"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/edit"
        android:visibility="gone"
        app:icon="@android:drawable/ic_menu_edit"
        app:iconSize="24dp"
        app:iconTint="@color/edit_icon_color" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteIncome"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:visibility="gone"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconSize="24dp"
        app:iconTint="@color/delete_icon_color" />
</LinearLayout>
