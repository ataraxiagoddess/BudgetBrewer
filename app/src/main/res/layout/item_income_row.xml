<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="2dp"
    android:paddingHorizontal="8dp"
    android:layout_marginBottom="1dp"
    android:gravity="center_vertical"
    android:background="@null">

    <!-- Time frame column -->
    <TextView
        android:id="@+id/tvTimeFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="45dp"
        android:maxLines="2"
        android:ellipsize="end"
        style="@style/TextAppearance.BudgetBrewer.Subtext"
        android:textColor="@color/text_on_container"
        android:layout_marginEnd="8dp"
        android:gravity="start"
        android:background="@null"/>

    <!-- Stacked source and amount columns -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.BudgetBrewer.Body"
            android:textColor="@color/text_on_container"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:background="@null"
            tools:ignore="VisualLintSystemUi" />

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.BudgetBrewer.Body"
            android:textColor="@color/text_on_container"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:background="@null"
            tools:ignore="VisualLintSystemUi" />
    </LinearLayout>

    <!-- Add Income button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddIncome"
        style="@style/Widget.BudgetBrewer.Button.Container"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/add_income_button"
        android:visibility="gone"
        app:icon="@null" />

    <!-- Edit button -->
    <ImageButton
        android:id="@+id/btnEditIncome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="@color/edit_icon_color"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/edit"
        android:visibility="gone" />

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/btnDeleteIncome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/delete_icon_color"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:visibility="gone" />
</LinearLayout>
