<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="2dp"
    android:paddingHorizontal="4dp"
    android:layout_marginBottom="0dp"
    android:gravity="center_vertical"
    android:background="@null">

    <!-- Source and amount container – wraps content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_weight="1"
        android:paddingVertical="4dp"
        android:paddingHorizontal="4dp"
        android:orientation="vertical"
        android:background="@null">

        <TextView
            android:id="@+id/tvTipSource"
            style="@style/TextAppearance.BudgetBrewer.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:textColor="@color/text_on_container"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            android:textStyle="bold" />

        <!-- Amount text, directly after source -->
        <TextView
            android:id="@+id/tvTipAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.BudgetBrewer.BodySmall"
            android:textColor="@color/text_on_container"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            android:ellipsize="end"
            android:textStyle="bold"
            android:background="@null" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditTip"
        style="@style/Widget.BudgetBrewer.Button.Icon.Container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/edit"
        app:icon="@android:drawable/ic_menu_edit"
        app:iconSize="24dp"
        app:iconTint="@color/edit_icon_color" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteTip"
        style="@style/Widget.BudgetBrewer.Button.Icon.Container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/delete"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconSize="24dp"
        app:iconTint="@color/delete_icon_color" />
</LinearLayout>