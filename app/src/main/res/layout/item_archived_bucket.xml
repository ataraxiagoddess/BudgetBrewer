<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/category_background"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: name + type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBucketName"
            style="@style/TextAppearance.BudgetBrewer.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:textColor="@color/text_on_container"
            android:textStyle="bold"
            tools:ignore="RtlSymmetry,VisualLintSystemUi" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <TextView
                android:id="@+id/tvBucketType"
                style="@style/TextAppearance.BudgetBrewer.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:textColor="@color/text_on_container"
                tools:ignore="RtlSymmetry" />

            <ImageView
                android:id="@+id/icBucketType"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: jar + target/actual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imageLiquid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/jar_liquid_clip"
                tools:ignore="ImageContrastCheck" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_jar_outline"
                tools:ignore="ImageContrastCheck" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTargetLabel"
                    style="@style/TextAppearance.BudgetBrewer.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/target_label"
                    android:textColor="@color/text_on_container" />

                <TextView
                    android:id="@+id/tvTargetAmount"
                    style="@style/TextAppearance.BudgetBrewer.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_container"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvActualLabel"
                    style="@style/TextAppearance.BudgetBrewer.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/actual_label"
                    android:textColor="@color/text_on_container"
                    tools:ignore="VisualLintBounds" />

                <TextView
                    android:id="@+id/tvActualAmount"
                    style="@style/TextAppearance.BudgetBrewer.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_container" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Restore + Delete buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestore"
            style="@style/Widget.BudgetBrewer.Button.Icon.Container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/restore"
            app:icon="@drawable/ic_restore"
            app:iconSize="24dp"
            app:iconTint="@color/edit_icon_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.BudgetBrewer.Button.Icon.Container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/delete"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconSize="24dp"
            app:iconTint="@color/delete_icon_color" />
    </LinearLayout>
</LinearLayout>
