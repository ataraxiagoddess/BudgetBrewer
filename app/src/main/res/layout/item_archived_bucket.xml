<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/category_background"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Row 1: name + type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/textViewBucketName"
            style="@style/TextAppearance.BudgetBrewer.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_on_container"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewBucketType"
            style="@style/TextAppearance.BudgetBrewer.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_on_container"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Row 2: jar + target/actual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imageLiquid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/jar_liquid_clip"
                android:scaleType="fitCenter" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_jar_outline"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvTargetLabel"
                    style="@style/TextAppearance.BudgetBrewer.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_label"
                    android:textColor="@color/text_on_container"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/textViewTargetAmount"
                    style="@style/TextAppearance.BudgetBrewer.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_container"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvActualLabel"
                    style="@style/TextAppearance.BudgetBrewer.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/actual_label"
                    android:textColor="@color/text_on_container"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/textViewActualAmount"
                    style="@style/TextAppearance.BudgetBrewer.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_container" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Restore + Delete buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <ImageButton
            android:id="@+id/btnRestore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_restore"
            android:contentDescription="@string/restore"
            app:tint="@color/edit_icon_color" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="@string/delete"
            app:tint="@color/delete_icon_color"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>