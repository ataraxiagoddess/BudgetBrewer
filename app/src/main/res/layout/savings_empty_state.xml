<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imageViewJar"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_jar_outline"
        android:contentDescription="@string/savings_title"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/textViewEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/empty_savings_title"
        style="@style/TextAppearance.BudgetBrewer.Header"
        android:textColor="@color/text_on_main" />

    <TextView
        android:id="@+id/textViewEmptyMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/empty_savings_message"
        style="@style/TextAppearance.BudgetBrewer.Body"
        android:textColor="@color/text_on_main"
        android:gravity="center"
        android:paddingHorizontal="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAddBucket"
        style="@style/Widget.BudgetBrewer.Button.Main"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:text="@string/add_bucket" />
</LinearLayout>