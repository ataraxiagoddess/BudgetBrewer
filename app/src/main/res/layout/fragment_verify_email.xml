<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Centered content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="72dp"
            android:paddingBottom="60dp">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/budget_brewer_logo"
                tools:ignore="ImageContrastCheck" />

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:fontFamily="@font/blkchcry"
                android:text="@string/app_name"
                android:textColor="@color/text_on_main"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvEmailSent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/exo_regular"
                android:gravity="center"
                android:textColor="@color/text_on_main"
                android:textSize="16sp" />

            <!-- Code input – now with maxWidth to avoid edge‑to‑edge -->
            <EditText
                android:id="@+id/etCode"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/exo_regular"
                android:gravity="center_vertical"
                android:hint="@string/verification_code"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="number"
                android:maxWidth="280dp"
                android:maxLength="6"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:textColor="@color/text_on_container"
                android:textColorHint="@color/text_disabled"
                android:textSize="14sp"
                tools:ignore="VisualLintTextFieldSize" />

            <!-- Verify button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                style="@style/Widget.BudgetBrewer.Button.Main"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="@string/verify" />

            <!-- Resend link -->
            <TextView
                android:id="@+id/btnResend"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/exo_regular"
                android:padding="8dp"
                android:text="@string/resend_code"
                android:textColor="@color/text_on_main"
                android:textSize="14sp" />

            <!-- Hint for users who are already verified -->
            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo_regular"
                android:gravity="center"
                android:maxWidth="300dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/verification_hint"
                android:textColor="@color/text_on_main"
                android:textSize="14sp" />

            <!-- Sign in instead link -->
            <TextView
                android:id="@+id/tvSignInInstead"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/exo_regular"
                android:padding="8dp"
                android:text="@string/sign_in_instead"
                android:textColor="@color/text_on_main"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Back button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.BudgetBrewer.Button.Container"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:text="@string/back"
        app:icon="@drawable/ic_chevron_left"
        app:iconGravity="textStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="VisualLintSystemUi" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>