<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp"
    app:contentPadding="16dp"
    app:strokeWidth="0dp"
    android:background="@drawable/category_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Color indicator circle (programmatic tint) -->
        <View
            android:id="@+id/viewColorIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_color_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewBucketName"
                style="@style/TextAppearance.BudgetBrewer.Subheader"
                android:textColor="@color/text_on_container" />

            <TextView
                android:id="@+id/textViewBucketType"
                style="@style/TextAppearance.BudgetBrewer.BodySmall"
                android:textColor="@color/text_on_container"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewTargetAmount"
            style="@style/TextAppearance.BudgetBrewer.Subheader"
            android:textColor="@color/text_on_container"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>