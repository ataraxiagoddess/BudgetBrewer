<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/category_background"
    android:padding="8dp"
    android:layout_marginBottom="2dp"
    android:elevation="2dp">

    <!-- Jar area (80dp x 80dp) -->
    <FrameLayout
        android:id="@+id/jarContainer"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginEnd="12dp">

        <!-- Liquid view – placed behind the jar outline, anchored to bottom -->
        <ImageView
            android:id="@+id/imageLiquid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/jar_liquid_clip"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <!-- Jar outline (ic_jar_outline) – transparent interior shows liquid -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_jar_outline"
            android:scaleType="fitCenter"
            android:contentDescription="@string/savings_title" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textViewBucketName"
            style="@style/TextAppearance.BudgetBrewer.Subheader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_container" />

        <TextView
            android:id="@+id/textViewBucketType"
            style="@style/TextAppearance.BudgetBrewer.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_container"
            android:layout_marginTop="4dp" />

        <!-- Goal exceeded label (hidden by default) -->
        <TextView
            android:id="@+id/textViewGoalExceeded"
            style="@style/TextAppearance.BudgetBrewer.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/net_negative"
            android:visibility="gone"
            android:text="@string/goal_exceeded"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textViewTargetAmount"
        style="@style/TextAppearance.BudgetBrewer.Subheader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_on_container"
        android:visibility="gone" />
</LinearLayout>