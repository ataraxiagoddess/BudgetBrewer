<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_bucket"
            style="@style/TextAppearance.BudgetBrewer.DialogTitle"
            android:textColor="@color/text_on_dialog"
            android:layout_marginBottom="16dp" />

        <!-- Bucket Name -->
        <EditText
            android:id="@+id/editTextBucketName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/bucket_name"
            android:inputType="text"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="8dp"
            android:textColorHint="@color/text_disabled"
            android:textAppearance="@style/TextAppearance.BudgetBrewer.Body"
            android:layout_marginBottom="12dp" />

        <!-- Goal vs Growth Radio Group -->
        <RadioGroup
            android:id="@+id/radioGroupType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radioGoal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/goal"
                android:checked="true"
                android:textColor="@color/text_on_dialog"
                android:buttonTint="@color/text_on_dialog"
                style="@style/TextAppearance.BudgetBrewer.Body" />

            <RadioButton
                android:id="@+id/radioGrowth"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/growth"
                android:textColor="@color/text_on_dialog"
                android:buttonTint="@color/text_on_dialog"
                style="@style/TextAppearance.BudgetBrewer.Body" />
        </RadioGroup>

        <!-- Target Amount -->
        <EditText
            android:id="@+id/editTextTargetAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/target_amount"
            android:inputType="numberDecimal"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="8dp"
            android:textColorHint="@color/text_disabled"
            android:textAppearance="@style/TextAppearance.BudgetBrewer.Body"
            android:layout_marginBottom="16dp" />

        <!-- Color Picker Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_color"
            style="@style/TextAppearance.BudgetBrewer.Body"
            android:textColor="@color/text_on_dialog"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancel"
                style="@style/Widget.BudgetBrewer.Button.Dialog"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCreate"
                style="@style/Widget.BudgetBrewer.Button.Dialog"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:text="@string/create_bucket" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>