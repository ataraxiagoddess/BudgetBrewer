<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacer_top"
                android:visibility="invisible" />

            <!-- TRUE TWO-COLUMN GRID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- LEFT COLUMN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <!-- 1. Income vs Expenses Chart -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/category_background"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_income_vs_expenses"
                            style="@style/TextAppearance.BudgetBrewer.Subheader.Container"
                            android:layout_marginBottom="16dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/incomeCircle"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:layout_gravity="center"
                                android:indeterminate="false"
                                app:indicatorSize="140dp"
                                app:trackThickness="70dp"
                                app:trackColor="@color/chart_income"
                                app:indicatorColor="@color/chart_income"
                                app:showAnimationBehavior="none"
                                android:importantForAccessibility="no" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/expensesRing"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:layout_gravity="center"
                                android:indeterminate="false"
                                app:indicatorSize="140dp"
                                app:trackThickness="12dp"
                                app:trackColor="@android:color/transparent"
                                app:indicatorColor="@color/chart_expenses"
                                app:showAnimationBehavior="none"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">

                                <TextView
                                    android:id="@+id/tvIncomeCenter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/exo_regular"
                                    android:textColor="@color/text_on_main"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    app:autoSizeTextType="uniform"
                                    app:autoSizeMinTextSize="10sp"
                                    app:autoSizeMaxTextSize="20sp"
                                    app:autoSizeStepGranularity="1sp"
                                    tools:ignore="TextContrastCheck"
                                    tools:text="$0.00" />

                                <TextView
                                    android:id="@+id/tvIncomeLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/exo_regular"
                                    android:text="@string/income"
                                    android:textColor="@color/text_on_main"
                                    android:textSize="12sp"
                                    tools:ignore="TextContrastCheck" />
                            </LinearLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="8dp">

                            <View
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:background="@color/chart_expenses"
                                android:layout_marginEnd="8dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tvExpensesData"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextAppearance.BudgetBrewer.Body.Container"
                                android:fontFamily="@font/exo_regular"
                                tools:text="Expenses: $12.34 (5.5%)" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 2. Savings Comparison -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/category_background"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.BudgetBrewer.Subheader.Container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="@string/chart_savings_comparison" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/savingsProgressIndicator"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="@font/exo_regular"
                                android:importantForAccessibility="no"
                                android:indeterminate="false"
                                app:indicatorColor="@color/chart_actual"
                                app:indicatorSize="100dp"
                                app:trackColor="@color/chart_target"
                                app:trackThickness="12dp" />

                            <TextView
                                android:id="@+id/tvSavingsPercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/exo_regular"
                                android:textColor="@color/text_on_container"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="0%" />

                            <TextView
                                android:id="@+id/tvSavingsOverachievement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/exo_regular"
                                android:textColor="@android:color/holo_green_dark"
                                android:textSize="14sp"
                                android:visibility="gone"
                                tools:text="+25% over target" />
                        </LinearLayout>

                        <!-- Savings Comparison Legend (vertical stack) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="vertical">

                            <!-- Target -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@color/chart_target"
                                    android:importantForAccessibility="no" />

                                <TextView
                                    style="@style/TextAppearance.BudgetBrewer.Body.Container"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/savings_target" />
                            </LinearLayout>

                            <!-- Actual -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@color/chart_actual"
                                    android:importantForAccessibility="no" />

                                <TextView
                                    style="@style/TextAppearance.BudgetBrewer.Body.Container"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/actual_savings" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSavingsData"
                            style="@style/TextAppearance.BudgetBrewer.Body.Container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/exo_regular"
                            android:gravity="center_horizontal"
                            tools:ignore="TextContrastCheck"
                            tools:text="Target: $800.00  |  Actual: $500.00" />
                    </LinearLayout>

                    <!-- 3. Spending by Tag Chart -->
                    <LinearLayout
                        android:id="@+id/layoutSpendingByTagContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/category_background"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvSpendingByTagHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spending_by_tag_header"
                            style="@style/TextAppearance.BudgetBrewer.Subheader.Container"
                            android:layout_marginBottom="16dp" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chartSpendingByTag"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginBottom="16dp"
                            android:importantForAccessibility="no" />

                        <!-- Legend will be populated dynamically -->
                        <LinearLayout
                            android:id="@+id/tagsLegendContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </LinearLayout>

                <!-- RIGHT COLUMN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <!-- 1. Expenses Breakdown (Donut Chart) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/category_background"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_expenses_breakdown"
                            style="@style/TextAppearance.BudgetBrewer.Subheader.Container"
                            android:layout_marginBottom="16dp" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chartExpensesBreakdown"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginBottom="16dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:id="@+id/expensesLegendContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- 2. Spending Trends -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/category_background"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.BudgetBrewer.Subheader.Container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="@string/chart_spending_trends" />

                        <!-- Timeframe selector -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/category_background"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimeframe1m"
                                style="@style/Widget.BudgetBrewer.TimeframeButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_timeframe_button_1m"
                                android:checkable="true"
                                android:text="@string/timeframe_1m" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimeframe3m"
                                style="@style/Widget.BudgetBrewer.TimeframeButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_timeframe_button_3m"
                                android:checkable="true"
                                android:text="@string/timeframe_3m" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimeframe6m"
                                style="@style/Widget.BudgetBrewer.TimeframeButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_timeframe_button_6m"
                                android:checkable="true"
                                android:text="@string/timeframe_6m" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimeframe1y"
                                style="@style/Widget.BudgetBrewer.TimeframeButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_timeframe_button_1y"
                                android:checkable="true"
                                android:text="@string/timeframe_1y" />
                        </LinearLayout>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chartSpendingTrends"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginBottom="16dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:id="@+id/spendingDataContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacer_bottom"
                android:visibility="invisible" />

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:background="@android:color/transparent"
        android:elevation="4dp" />

</FrameLayout>